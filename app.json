
{
  "expo": {
    "name": "Portion Tracker",
    "slug": "Portion Tracker",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/9b2acb8c-6cd5-475b-8286-4171fe236ec4.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/9b2acb8c-6cd5-475b-8286-4171fe236ec4.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.portiontracker.app",
      "appleTeamId": "9978T8842P",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to take photos of your meals for tracking purposes.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select meal photos.",
        "NSPhotoLibraryAddUsageDescription": "This app needs permission to save photos to your library."
      },
      "buildNumber": "6"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/9b2acb8c-6cd5-475b-8286-4171fe236ec4.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.portiontracker.app",
      "versionCode": 6,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/images/9b2acb8c-6cd5-475b-8286-4171fe236ec4.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-superwall",
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to select meal photos.",
          "cameraPermission": "This app uses the camera to take photos of your meals for tracking purposes."
        }
      ]
    ],
    "scheme": "portiontracker",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
}
