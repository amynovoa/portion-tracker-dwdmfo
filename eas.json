
{
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "autoIncrement": true
        },
        "preview": {
            "distribution": "internal",
            "autoIncrement": true
        },
        "production": {
            "autoIncrement": true
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "your-apple-id@example.com",
                "ascAppId": "your-app-store-connect-id",
                "appleTeamId": "your-team-id"
            },
            "android": {
                "serviceAccountKeyPath": "./path-to-your-service-account-key.json",
                "track": "internal"
            }
        }
    }
}
