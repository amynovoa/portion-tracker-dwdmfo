
# Superwall API Key
# IMPORTANT: For production builds, you MUST set this in EAS Build secrets
# Go to: https://expo.dev/accounts/[account]/projects/[project]/secrets
# Add secret: EXPO_PUBLIC_SUPERWALL_API_KEY with your actual Superwall API key
# 
# For local development and TestFlight testing:
# 1. Get your API key from Superwall dashboard: https://superwall.com/dashboard
# 2. Replace the value below with your actual API key
# 3. DO NOT commit your real API key to git
#
# The app will work without a valid key (uses simulated subscriptions for testing)
# but you need a real key for production App Store builds
EXPO_PUBLIC_SUPERWALL_API_KEY=pk_test_placeholder_key_replace_with_real_key
