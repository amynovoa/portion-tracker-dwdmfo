
# TestFlight Bypass Toggle
# Set to 'true' to enable TestFlight bypass (allows testing without real purchases)
# Set to 'false' to test real sandbox purchases in TestFlight
# IMPORTANT: This MUST be 'false' for App Store production builds
EXPO_PUBLIC_STOREKIT_TESTFLIGHT_BYPASS=true

# For production App Store builds, set this to false in EAS Build secrets:
# Go to: https://expo.dev/accounts/[account]/projects/[project]/secrets
# Add secret: EXPO_PUBLIC_STOREKIT_TESTFLIGHT_BYPASS with value 'false'
